{
  "schemaVersion": 1,
  "sourceApiVersion": 1,
  "minRuntimeAbi": 1,
  "id": "filmorax.source.xhamster",
  "name": "xHamster",
  "description": "xHamster catalogue, filters, metadata and native xPlayer streams",
  "version": "1.0.0",
  "minAppVersion": "1.0.0",
  "publisherKeyId": "filmorax.sources",
  "entrypoint": "src/index.mjs",
  "permissions": ["http", "html", "settings"],
  "sources": [
    {
      "id": "xhamster",
      "name": "xHamster",
      "description": "source.description.xhamster",
      "language": "international",
      "category": "movies",
      "baseUrl": "https://xhamster.com",
      "isNsfw": true,
      "supportsTorrentSearch": false,
      "capabilities": [
        "catalog",
        "search",
        "filters",
        "metadata",
        "playbackGroups",
        "recommendations",
        "streams",
        "headers",
        "mirrors"
      ],
      "parameters": {},
      "network": {
        "origins": [
          "https://xhamster.com",
          "https://xhamster.one",
          "https://xhamster.desi",
          "https://xhms.pro",
          "https://xhday.com",
          "https://xhvid.com"
        ],
        "imageOrigins": ["https://xhcdn.com", "https://xhamster.com", "https://flixcdn.com"],
        "streamOrigins": ["https://xhcdn.com"],
        "cookieDefaults": [
          {
            "origin": "https://xhamster.com",
            "name": "age_verified",
            "value": "1"
          },
          {
            "origin": "https://xhamster.com",
            "name": "age_verified_en",
            "value": "1"
          },
          {
            "origin": "https://xhamster.com",
            "name": "age",
            "value": "1"
          },
          {
            "origin": "https://xhamster.com",
            "name": "adult",
            "value": "1"
          },
          {
            "origin": "https://xhamster.com",
            "name": "is_adult",
            "value": "1"
          },
          {
            "origin": "https://xhamster.com",
            "name": "agree",
            "value": "1"
          }
        ],
        "methods": ["GET"],
        "maxConcurrentRequests": 4,
        "allowUserBaseUrl": true,
        "userBaseUrlUses": ["image"],
        "allowSubdomains": true
      },
      "presentation": {
        "icon": "assets/icon.png",
        "directPlayback": true,
        "artworkLayout": "landscape",
        "imageHeaders": {
          "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36",
          "Accept": "image/avif,image/webp,image/apng,image/svg+xml,image/*,*/*;q=0.8",
          "Accept-Language": "en-US,en;q=0.9,ru;q=0.7",
          "Referer": "https://xhamster.com/"
        }
      }
    }
  ],
  "resolvers": [
    {
      "id": "xhamster.streams",
      "sourceId": "xhamster",
      "schemes": ["https", "http"],
      "origins": [
        "https://xhamster.com",
        "https://xhamster.one",
        "https://xhamster.desi",
        "https://xhms.pro",
        "https://xhday.com",
        "https://xhvid.com"
      ]
    }
  ],
  "contributions": {
    "hostFeatures": []
  },
  "files": {}
}
